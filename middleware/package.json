{
  "name": "aromas-middleware",
  "version": "0.1.0",
  "private": true,
  "description": "Middleware de sincronização PHC -> loja Shopify (Aromas da Tarde). Fase atual: dry-run só de leitura.",
  "type": "commonjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "dry-run": "node src/dry-run.js",
    "sync": "node src/sync.js",
